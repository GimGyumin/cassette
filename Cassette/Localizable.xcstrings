      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music tokens require a paid Apple Developer Program membership ($99/year) to create a MusicKit key. If you do not have one, choose Spotify above or leave this empty — Cassette will still use free MusicBrainz for ISRC."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music 토큰으로 MusicKit 키를 만들려면 유료 Apple Developer Program 멤버십(연 $99)이 필요합니다. 멤버십이 없다면 위에서 Spotify를 선택하거나 비워 두세요. Cassette는 ISRC 조회에 무료 MusicBrainz를 계속 사용합니다."
          }
        }
