        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads continue in the background. Check progress in Account."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드는 백그라운드에서 계속됩니다. 계정에서 진행 상황을 확인하세요."
          }
        }
      }
    },
    "Downloads continue when you leave this screen. iOS controls background execution and may pause work to save power. Cassette automatically resumes unfinished work when allowed or when you reopen the app. Playback and device temperature take priority." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads continue when you leave this screen. iOS controls background execution and may pause work to save power. Cassette automatically resumes unfinished work when allowed or when you reopen the app. Playback and device temperature take priority."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 화면을 나가도 다운로드는 계속됩니다. iOS의 백그라운드 실행 관리에 따라 절전을 위해 잠시 멈출 수 있으며, 실행이 허용되거나 앱을 다시 열면 남은 작업이 자동으로 이어집니다. 음악 재생과 기기 온도를 우선하여 처리 속도를 조절합니다."
          }
        }
      }
    },
